# Copy this file to .env. Never commit .env or paste real credentials into an issue.
# The application can run without DeepSeek; AI routing requires your own key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional unattended Power BI/Fabric publishing. Leave blank unless configured.
POWER_BI_TENANT_ID=
POWER_BI_CLIENT_ID=
POWER_BI_CLIENT_SECRET=
POWER_BI_WORKSPACE_ID=

# Optional retention override (days).
TASK_RETENTION_DAYS=30
